{
  "name": "proyecto-parcel",
  "version": "1.0.0",
  "description": "Proyecto de práctica que utiliza Parcel como bundler y consume la Fake API de Plazi para disimular el consumo de datos.",
  "keywords": [
    "Parcel",
    "API"
  ],
  "homepage": "https://github.com/Manuel-Antonio1/Proyecto-Parcel#readme",
  "bugs": {
    "url": "https://github.com/Manuel-Antonio1/Proyecto-Parcel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manuel-Antonio1/Proyecto-Parcel.git"
  },
  "license": "ISC",
  "author": "Manuel Antonio Vargas Perez <manuel.vp.official@gmail.com>",
  "type": "commonjs",
  "source": "src/index.html",
  "scripts": {
    "start": "parcel  serve --port 8080 src/index.html src/categorias.html",
    "build": "parcel build src/index.html src/categorias.html --public-url ./"
  },
  "devDependencies": {
    "parcel": "^2.16.4",
    "posthtml-include": "^2.0.1"
  }
}
